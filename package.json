{
  "name": "@ostro/filesystem",
  "version": "2.0.0-alpha.1",
  "description": "filesystem module for OstroJS",
  "main": "build/filesystemManager.js",
  "types": "build/filesystemManager.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/filesystemManager.d.ts",
      "default": "./build/filesystemManager.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/support": "^2.0.0-alpha.1",
    "@ostro/contracts": "^2.0.0-alpha.1",
    "fs-extra": "^10.0.0",
    "lodash.get": "^4.4.2",
    "filehound": "^1.17.4",
    "uuid": "^8.3.2"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "filesystem",
    "storage",
    "NodeJS Filesystem",
    "OstroJS Filesystem"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/filesystem.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/filesystem/issues"
  },
  "homepage": "https://github.com/ostrojs/filesystem#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
